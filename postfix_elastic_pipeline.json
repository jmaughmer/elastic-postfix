          "OPENDKIM_VERIFICATION": "DKIM verification %{DATA:opendkim_verification}",
          "OPENDKIM": "%{POSTFIX_QUEUEID:postfix_queueid}: (%{OPENDKIM_VERIFICATION}|%{OPENDKIM_EXTERNAL}|%{OPENDKIM_PARSE_FAILURE}|%{OPENDKIM_KEY_FAILED}|%{OPENDKIM_NO_TABLE_MATCH}|%{OPENDKIM_SIGNATURE})|%{OPENDKIM_LIFECYCLE}",
          "OPENDKIM_EXTERNAL": "external host %{DATA:opendkim_client_hostname} attempted to send as %{DATA:opendkim_domain}",
          "OPENDKIM_KEY_FAILED": """key retrieval failed \(s=%{DATA:opendkim_selector}, d=%{DATA:opendkim_domain}\)(: %{GREEDYDATA:opendkim_key_error})?""",
          "OPENDKIM_NO_TABLE_MATCH": "no signing table match for '%{DATA:opendkim_sender}'",
          "OPENDKIM_LIFECYCLE": """OpenDKIM Filter( v%{DATA:opendkim_version} (starting( \(args: %{GREEDYDATA:opendkim_args}\))?|terminating with status %{INT:opendkim_exit_status:int}, errno = %{INT:opendkim_errno:int})|: %{GREEDYDATA:opendkim_lifecycle_message})""",
          "OPENDKIM_SIGNATURE_MISSING": "no signature data",
          "POSTFIX_QUEUEID": "([0-9A-F]{6,}|[0-9a-zA-Z]{12,}|NOQUEUE)",
          "OPENDKIM_SIGNATURE": "(%{OPENDKIM_SIGNATURE_ADDED}|%{OPENDKIM_SIGNATURE_BAD}|%{OPENDKIM_SIGNATURE_MISSING}|%{OPENDKIM_SIGNATURE_NOT_AUTHENTICATED}|%{OPENDKIM_SIGNATURE_NOT_INTERNAL}|%{OPENDKIM_SIGNATURES})",
          "OPENDKIM_SIGNATURES": "message has signatures from %{GREEDYDATA:opendkim_signature_existing}",
          "OPENDKIM_CLIENT": """%{HOSTNAME:opendkim_client_hostname} \[%{IP:opendkim_client_ip}\]""",
          "OPENDKIM_SIGNATURE_NOT_AUTHENTICATED": "not authenticated",
          "OPENDKIM_SIGNATURE_ADDED": """DKIM-Signature field added \(%{GREEDYDATA:opendkim_signature}\)""",
          "OPENDKIM_SIGNATURE_BAD": "bad signature data",
