{
  "processors": [
    {
      "set": {
        "field": "event.original",
        "copy_from": "message",
        "override": false,
        "ignore_empty_value": true
      }
    },
    {
      "grok": {
        "ignore_missing": true,
        "field": "message",
        "tag": "grok_syslog",
        "description": "Syslog header with a BSD (Oct 14 10:00:00) or ISO 8601 timestamp",
        "patterns": [
          """(?:%{SYSLOGTIMESTAMP:_tmp_timestamp}|%{TIMESTAMP_ISO8601:_tmp_timestamp}) %{SYSLOGHOST:log.syslog.hostname} %{PROG:program}(?:\[%{POSINT:process.pid:long}\])?: %{GREEDYDATA:message}"""
        ],
        "on_failure": [
          {
            "append": {
              "if": "ctx.process?.name == null && ctx.log?.syslog?.appname == null",
              "field": "tags",
              "value": ["_grok_syslog_nomatch"],
              "allow_duplicates": false
            }
          }
        ]
      }
    },
    {
      "set": {
        "description": "The shipper already stripped the syslog header",
        "if": "ctx.program == null && ctx.process?.name != null",
        "field": "program",
        "copy_from": "process.name"
      }
    },
    {
      "set": {
        "if": "ctx.program == null && ctx.log?.syslog?.appname != null",
        "field": "program",
        "copy_from": "log.syslog.appname"
      }
    },
    {
      "gsub": {
        "description": "Collapse the double space syslog uses before single-digit days",
        "field": "_tmp_timestamp",
        "pattern": """\s+""",
        "replacement": " ",
        "ignore_missing": true
      }
    },
    {
      "date": {
        "tag": "date_syslog_utc",
        "if": "ctx._tmp_timestamp != null && ctx.event?.timezone == null",
        "field": "_tmp_timestamp",
        "formats": [
          "MMM d HH:mm:ss",
          "MMM d HH:mm:ss.SSS",
          "MMM d HH:mm:ss.SSSSSS",
          "ISO8601"
        ],
        "on_failure": [
          {
            "append": {
              "field": "tags",
              "value": ["_date_parse_failure"],
              "allow_duplicates": false
            }
          }
        ]
      }
    },
    {
      "date": {
        "tag": "date_syslog_tz",
        "if": "ctx._tmp_timestamp != null && ctx.event?.timezone != null",
        "field": "_tmp_timestamp",
        "timezone": "{{{event.timezone}}}",
        "formats": [
          "MMM d HH:mm:ss",
          "MMM d HH:mm:ss.SSS",
          "MMM d HH:mm:ss.SSSSSS",
          "ISO8601"
        ],
        "on_failure": [
          {
            "append": {
              "field": "tags",
              "value": ["_date_parse_failure"],
              "allow_duplicates": false
            }
          }
        ]
      }
    },
    {
      "set": {
        "description": "BSD timestamps have no year, so the date processor assumes the current one",
        "if": "ctx._tmp_timestamp != null && !ctx._tmp_timestamp.contains('-') && (ctx.tags == null || !ctx.tags.contains('_date_parse_failure'))",
        "field": "_tmp_now",
        "value": "{{_ingest.timestamp}}"
      }
    },
    {
      "script": {
        "tag": "syslog_year_rollover",
        "description": "A December line ingested in January lands in the future; move it back a year",
        "if": "ctx._tmp_now != null",
        "lang": "painless",
        "source": "ZonedDateTime ts = ZonedDateTime.parse(ctx['@timestamp']); ZonedDateTime now = ZonedDateTime.parse(ctx['_tmp_now']); if (ts.isAfter(now.plusDays(2))) { ctx['@timestamp'] = ts.minusYears(1).toString(); }",
        "on_failure": [
          {
            "append": {
              "field": "tags",
              "value": ["_year_rollover_failure"],
              "allow_duplicates": false
            }
          }
        ]
      }
    },
    {
      "remove": {
        "field": ["_tmp_timestamp", "_tmp_now"],
        "ignore_missing": true
      }
    },
    {
      "set": {
        "description": "Prefix the message with program so each pattern only applies to the daemon that logs it",
        "if": "ctx.program != null && ctx.program.startsWith('postfix') && ctx.message != null",
        "field": "_pf",
        "value": "{{{program}}} {{{message}}}"
      }
    },
    {
      "grok": {
        "field": "_pf",
        "patterns": [
          """^\S*/smtpd %{POSTFIX_SMTPD}$""",
          """^\S*/(?:smtp|lmtp) %{POSTFIX_SMTP}$""",
          """^\S*/(?:qmgr|oqmgr) %{POSTFIX_QMGR}$""",
          """^\S*/cleanup %{POSTFIX_CLEANUP}$""",
          """^\S*/local %{POSTFIX_LOCAL}$""",
          """^\S*/virtual %{POSTFIX_VIRTUAL}$""",
          """^\S*/pipe %{POSTFIX_PIPE}$""",
          """^\S*/(?:error|retry) %{POSTFIX_ERROR}$""",
          """^\S*/discard %{POSTFIX_DISCARD}$""",
          """^\S*/pickup %{POSTFIX_PICKUP}$""",
          """^\S*/bounce %{POSTFIX_BOUNCE}$""",
          """^\S*/postscreen %{POSTFIX_POSTSCREEN}$""",
          """^\S*/dnsblog %{POSTFIX_DNSBLOG}$""",
          """^\S*/tlsproxy %{POSTFIX_TLSPROXY}$""",
          """^\S*/anvil %{POSTFIX_ANVIL}$""",
          """^\S*/scache %{POSTFIX_SCACHE}$""",
          """^\S*/master %{POSTFIX_MASTER}$""",
          """^\S*/postfix-script %{POSTFIX_SCRIPT}$""",
          """^\S*/postsuper %{POSTFIX_POSTSUPER}$""",
          """^\S*/verify %{POSTFIX_VERIFY}$""",
          """^\S+ %{POSTFIX_TABLE_CHANGE}$""",
          """^\S+ %{POSTFIX_WARNING}$"""
        ],
        "ignore_missing": true,
        "description": "Postfix Grok, routed by daemon (the text after the last / in program)",
        "tag": "grok_postfix",
        "pattern_definitions": {
          "POSTFIX_SMTPD_NOQUEUE": "%{POSTFIX_QUEUEID:postfix_queueid}: %{POSTFIX_ACTION:postfix_action}: %{POSTFIX_SMTP_STAGE:postfix_smtp_stage} from %{POSTFIX_CLIENT}:( %{POSTFIX_STATUS_CODE:postfix_status_code:int} %{POSTFIX_STATUS_CODE_ENHANCED:postfix_status_code_enhanced})?( <%{DATA:postfix_status_data}>:)? (%{POSTFIX_DNSBL_MESSAGE}|%{GREEDYDATA:postfix_status_message};) %{POSTFIX_KEYVALUE_DATA:postfix_keyvalue_data}",
          "POSTFIX_DNSBLOG": "%{POSTFIX_DNSBLOG_LISTING}|%{POSTFIX_WARNING}",
          "POSTFIX_SMTPD_CONNECT": "%{POSTFIX_SESSION_CONNECT:event.action} from %{POSTFIX_CLIENT}",
          "POSTFIX_SESSION_CONNECT": "connect",
          "POSTFIX_SESSION_DISCONNECT": "disconnect",
          "POSTFIX_SMTP_PIX": "%{POSTFIX_QUEUEID:postfix_queueid}: enabling PIX workarounds: %{DATA:postfix_pix_workaround} for %{POSTFIX_RELAY}",
          "POSTFIX_WARNING_WITH_KV": "(%{POSTFIX_QUEUEID:postfix_queueid}: )?(?<postfix_message_level>(error|warning|fatal|info)): (%{POSTFIX_QUEUEID:postfix_queueid}: )?(%{POSTFIX_CLIENT}: )?%{GREEDYDATA:postfix_message}; %{POSTFIX_KEYVALUE_DATA:postfix_keyvalue_data}",
          "POSTFIX_LOSTCONN_REASONS": "(receiving the initial server greeting|sending message body|sending end of data -- message may be sent more than once|sending %{POSTFIX_SMTP_STAGE:postfix_smtp_stage}( command)?|%{GREEDYDATA})",
          "POSTFIX_ANVIL_CONN_CACHE": "statistics: max cache size %{NUMBER:postfix_anvil_cache_size:int} at %{SYSLOGTIMESTAMP:postfix_anvil_timestamp}",
          "POSTFIX_TLSPROXY_CONN": "(DIS)?CONNECT( from)? %{POSTFIX_CLIENT}",
          "POSTFIX_POSTSUPER_ACTIONS": "(removed|requeued|placed on hold|released from hold)",
          "POSTFIX_ANVIL_CONN_RATE": """statistics: max connection rate %{NUMBER:postfix_anvil_conn_rate:int}/(?<postfix_anvil_conn_period>\d+[smhd]) for \(%{DATA:postfix_service}:(%{IP_UNKNOWN:postfix_client_ip_unknown}|%{IP:postfix_client_ip})\) at %{SYSLOGTIMESTAMP:postfix_anvil_timestamp}""",
          "POSTFIX_POSTSUPER_SUMMARY": "%{POSTFIX_POSTSUPER_SUMMARY_ACTIONS:postfix_postsuper_summary_action}: %{NUMBER:postfix_postsuper_summary_count:int} messages?",
          "POSTFIX_TABLE_CHANGE": "table %{DATA:postfix_table} has changed -- restarting",
          "POSTFIX_SMTP_RELAYERR": """%{POSTFIX_QUEUEID:postfix_queueid}: host %{POSTFIX_RELAY} said: %{GREEDYDATA:postfix_smtp_response} \(in reply to %{POSTFIX_SMTP_STAGE:postfix_smtp_stage} command\)""",
          "POSTFIX_LOSTCONN": "(Connection timed out|No route to host|Connection refused|Network is unreachable|lost connection|timeout|SSL_accept error|-1|Address not available|Operation timed out|bare <LF> received)",
          "POSTFIX_SMTP": "%{POSTFIX_SMTP_DELIVERY}|%{POSTFIX_TLSCONN}|%{POSTFIX_SMTP_CONNERR}|%{POSTFIX_SMTP_SSLCONNERR}|%{POSTFIX_SMTP_SSLAUTHERR}|%{POSTFIX_SMTP_LOSTCONN}|%{POSTFIX_SMTP_TIMEOUT}|%{POSTFIX_SMTP_RELAYERR}|%{POSTFIX_SMTP_RELAYREFUSED}|%{POSTFIX_SMTP_TLSERR}|%{POSTFIX_WARNING}|%{POSTFIX_SMTP_UTF8}|%{POSTFIX_TLSVERIFICATION}|%{POSTFIX_SMTP_PIX}",
          "POSTFIX_SMTP_TLSERR": "%{POSTFIX_QUEUEID:postfix_queueid}: Cannot start TLS: %{GREEDYDATA:postfix_tls_error}",
          "POSTFIX_DISCARD_ANY": "%{POSTFIX_QUEUEID:postfix_queueid}: %{POSTFIX_KEYVALUE_DATA:postfix_keyvalue_data} status=%{STATUS_WORD:postfix_status} %{GREEDYDATA}",
          "POSTFIX_PS_DNSBL": "%{POSTFIX_PS_VIOLATION:postfix_postscreen_violation} rank %{INT:postfix_postscreen_dnsbl_rank:int} for %{POSTFIX_CLIENT}",
          "POSTFIX_VERIFY": "%{POSTFIX_VERIFY_CACHE}",
          "POSTFIX_POSTSUPER_ACTION": "%{POSTFIX_QUEUEID:postfix_queueid}: %{POSTFIX_POSTSUPER_ACTIONS:postfix_postsuper_action}",
          "POSTFIX_SMTPD_DISCARD": "discarding EHLO keywords: %{GREEDYDATA:postfix_ehlo_discard}",
          "POSTFIX_SMTP_CONNERR": "connect to %{POSTFIX_RELAY}: %{GREEDYDATA:postfix_smtp_lostconn_data}",
          "POSTFIX_CLEANUP_PREPEND_TYPE": "(header|body)",
          "POSTFIX_KEYVALUE_DATA": """[\w-]+=[^;]*""",
          "POSTFIX_PS_NOQUEUE": "%{POSTFIX_SMTPD_NOQUEUE}",
          "POSTFIX_BOUNCE": "%{POSTFIX_BOUNCE_NOTIFICATION}",
          "POSTFIX_KEYVALUE": "%{POSTFIX_QUEUEID:postfix_queueid}: %{POSTFIX_KEYVALUE_DATA:postfix_keyvalue_data}",
          "POSTFIX_PIPE_ANY": """%{POSTFIX_QUEUEID:postfix_queueid}: %{POSTFIX_KEYVALUE_DATA:postfix_keyvalue_data}, status=%{STATUS_WORD:postfix_status} \(%{GREEDYDATA:postfix_pipe_response}\)""",
          "POSTFIX_MASTER_START": "(daemon started|reload) -- version %{DATA:postfix_version}, configuration %{PATH:postfix_config_path}",
          "POSTFIX_BOUNCE_NOTIFICATION": "%{POSTFIX_QUEUEID:postfix_queueid}: (?<postfix_bounce_recipient>(sender|postmaster)) (?<postfix_bounce_reason>(non-delivery|delivery status|delay)) notification: %{POSTFIX_QUEUEID:postfix_bounce_queueid}",
          "POSTFIX_PIPE": "%{POSTFIX_PIPE_ANY}",
          "POSTFIX_QMGR_MESSAGE": "(removed|skipped, still being delivered)",
          "POSTFIX_SCACHE_LOOKUPS": "statistics: (address|domain) lookup hits=%{INT:postfix_scache_hits:int} miss=%{INT:postfix_scache_miss:int} success=%{INT:postfix_scache_success:int}%",
          "POSTFIX_POSTSUPER_SUMMARY_ACTIONS": "(Deleted|Requeued|Placed on hold|Released from hold)",
          "POSTFIX_SMTP_SSLAUTHERR": "%{POSTFIX_QUEUEID:postfix_queueid}: SASL authentication failed; server %{POSTFIX_RELAY} said: %{GREEDYDATA:postfix_smtp_response}",
          "POSTFIX_DISCARD": "%{POSTFIX_DISCARD_ANY}|%{POSTFIX_WARNING}",
          "POSTFIX_SCACHE": "%{POSTFIX_SCACHE_LOOKUPS}|%{POSTFIX_SCACHE_SIMULTANEOUS}|%{POSTFIX_SCACHE_TIMESTAMP}",
          "POSTFIX_ERROR": "%{POSTFIX_ERROR_ANY}",
          "POSTFIX_PS_ACCESS": "%{POSTFIX_PS_ACCESS_ACTION:postfix_postscreen_access} %{POSTFIX_CLIENT}",
          "POSTFIX_PS_CACHE": "cache %{DATA} full cleanup: retained=%{NUMBER:postfix_postscreen_cache_retained:int} dropped=%{NUMBER:postfix_postscreen_cache_dropped:int} entries",
          "POSTFIX_LOCAL": "%{POSTFIX_LOCAL_DELIVERY}|%{POSTFIX_WARNING}",
          "POSTFIX_POSTSCREEN": "%{POSTFIX_PS_CONNECT}|%{POSTFIX_PS_ACCESS}|%{POSTFIX_PS_NOQUEUE}|%{POSTFIX_PS_TOOBUSY}|%{POSTFIX_PS_CACHE}|%{POSTFIX_PS_DNSBL}|%{POSTFIX_PS_VIOLATIONS}|%{POSTFIX_WARNING}",
          "POSTFIX_PS_VIOLATION": "(BARE NEWLINE|COMMAND (TIME|COUNT|LENGTH) LIMIT|COMMAND PIPELINING|DNSBL|HANGUP|NON-SMTP COMMAND|PREGREET)",
          "POSTFIX_SMTP_RELAYREFUSED": "%{POSTFIX_QUEUEID:postfix_queueid}: host %{POSTFIX_RELAY} refused to talk to me: %{GREEDYDATA:postfix_smtp_response}",
          "POSTFIX_STATUS_CODE": """\d{3}""",
          "POSTFIX_DNSBL_MESSAGE": """Service unavailable; .* \[%{GREEDYDATA:postfix_status_data}\] %{GREEDYDATA:postfix_status_message};""",
          "POSTFIX_DNSBLOG_LISTING": "addr %{IP:postfix_client_ip} listed by domain %{HOSTNAME:postfix_dnsbl_domain} as %{IP:postfix_dnsbl_result}",
          "POSTFIX_SMTP_TIMEOUT": "%{POSTFIX_QUEUEID:postfix_queueid}: conversation with %{POSTFIX_RELAY} timed out( while %{POSTFIX_LOSTCONN_REASONS:postfix_smtp_lostconn_reason})?",
          "POSTFIX_QMGR_EXPIRED": "%{POSTFIX_QUEUEID:postfix_queueid}: from=<%{DATA:postfix_from}>, status=%{STATUS_WORD:postfix_status}, returned to sender",
          "POSTFIX_SMTPD_LOSTCONN": """%{POSTFIX_LOSTCONN:postfix_smtpd_lostconn_data}( after %{POSTFIX_SMTP_STAGE:postfix_smtp_stage}( \(%{INT} bytes\))?)? from %{POSTFIX_CLIENT}(: %{GREEDYDATA:postfix_smtpd_lostconn_reason})?""",
          "POSTFIX_SMTP_SSLCONNERR": "SSL_connect error to %{POSTFIX_RELAY}: %{POSTFIX_LOSTCONN:postfix_smtp_lostconn_data}",
          "POSTFIX_CLEANUP_PREPEND": "%{POSTFIX_QUEUEID:postfix_queueid}: (?<postfix_cleanup_action>(bcc|discard|filter|hold|info|prepend|redirect|reject|replace|warning)): %{POSTFIX_CLEANUP_PREPEND_TYPE:postfix_prepend_type} %{GREEDYDATA:postfix_prepend_trigger} from (%{POSTFIX_CLIENT}|local); %{GREEDYDATA_NO_COLON:postfix_keyvalue_data}(: %{GREEDYDATA:postfix_prepend_value})?",
          "POSTFIX_QMGR_ACTIVE": """%{POSTFIX_QUEUEID:postfix_queueid}: %{POSTFIX_KEYVALUE_DATA:postfix_keyvalue_data} \(queue active\)""",
          "POSTFIX_MASTER": "%{POSTFIX_MASTER_START}|%{POSTFIX_MASTER_EXIT}|%{POSTFIX_WARNING}",
          "POSTFIX_CLIENT": """%{POSTFIX_HOSTNAME:postfix_client_hostname}?\[(%{IP_UNKNOWN:postfix_client_ip_unknown}|%{IP:postfix_client_ip})\](:%{INT:postfix_client_port:int})?""",
          "POSTFIX_HOSTNAME": """[0-9A-Za-z_][0-9A-Za-z_.-]*""",
          "POSTFIX_SMTPD_DISCONNECT": "%{POSTFIX_SESSION_DISCONNECT:event.action} from %{POSTFIX_CLIENT}( %{DATA:postfix_command_counter_data})?$",
          "GREEDYDATA_NO_COLON": "[^:]*",
          "POSTFIX_CLEANUP_MILTER": "%{POSTFIX_QUEUEID:postfix_queueid}: milter-%{POSTFIX_ACTION:postfix_milter_result}: (%{POSTFIX_SMTP_STAGE:postfix_smtp_stage} from (%{POSTFIX_CLIENT}|local): )?%{GREEDYDATA:postfix_milter_message}; %{GREEDYDATA_NO_COLON:postfix_keyvalue_data}(: %{GREEDYDATA:postfix_milter_data})?",
          "POSTFIX_CLEANUP_MESSAGEID": "%{POSTFIX_QUEUEID:postfix_queueid}: message-id=<?%{GREEDYDATA_NO_BRACKET:postfix_message-id}>?",
          "POSTFIX_SMTP_STAGE": """(CONNECT|HELO|EHLO|STARTTLS|AUTH|MAIL( FROM)?|RCPT( TO)?|(end of )?DATA|BDAT|RSET|UNKNOWN|END-OF-MESSAGE|VRFY|\.)""",
          "POSTFIX_SMTPD_PIPELINING": "improper command pipelining after %{POSTFIX_SMTP_STAGE:postfix_smtp_stage} from %{POSTFIX_CLIENT}: %{GREEDYDATA:postfix_improper_pipelining_data}",
          "POSTFIX_LOCAL_DELIVERY": """%{POSTFIX_KEYVALUE} status=%{STATUS_WORD:postfix_status}( \(%{GREEDYDATA:postfix_local_response}\))?""",
          "POSTFIX_SMTP_LOSTCONN": "%{POSTFIX_QUEUEID:postfix_queueid}: %{POSTFIX_LOSTCONN:postfix_smtp_lostconn_data} with %{POSTFIX_RELAY}( while %{POSTFIX_LOSTCONN_REASONS:postfix_smtp_lostconn_reason})?",
          "POSTFIX_QMGR_INFO": "%{POSTFIX_QUEUEID:postfix_queueid}: %{POSTFIX_QMGR_MESSAGE:postfix_message}",
          "POSTFIX_SMTPD": "%{POSTFIX_SMTPD_CONNECT}|%{POSTFIX_SMTPD_DISCONNECT}|%{POSTFIX_SMTPD_NOQUEUE}|%{POSTFIX_CLEANUP_MILTER}|%{POSTFIX_TLSCONN}|%{POSTFIX_SMTPD_LOSTCONN}|%{POSTFIX_SMTPD_TOOMANYERR}|%{POSTFIX_SMTPD_PIPELINING}|%{POSTFIX_SMTPD_DISCARD}|%{POSTFIX_WARNING}|%{POSTFIX_SMTPD_PROXY}|%{POSTFIX_KEYVALUE}",
          "POSTFIX_SMTPD_TOOMANYERR": "too many errors after %{POSTFIX_SMTP_STAGE:postfix_smtp_stage} from %{POSTFIX_CLIENT}",
          "POSTFIX_VERIFY_CACHE": "cache %{DATA} (?<postfix_verify_cleanup_type>(full|partial)) cleanup: retained=%{INT:postfix_verify_cache_retained:int} dropped=%{INT:postfix_verify_cache_dropped:int} entries",
          "POSTFIX_POSTSUPER": "%{POSTFIX_POSTSUPER_ACTION}|%{POSTFIX_POSTSUPER_SUMMARY}",
          "IP_UNKNOWN": "unknown",
          "POSTFIX_ERROR_ANY": """(%{POSTFIX_QUEUEID:postfix_queueid}: )?%{POSTFIX_KEYVALUE_DATA:postfix_keyvalue_data}, status=%{STATUS_WORD:postfix_status} \(%{GREEDYDATA:postfix_error_response}\)""",
          "POSTFIX_ANVIL": "%{POSTFIX_ANVIL_CONN_RATE}|%{POSTFIX_ANVIL_RATE}|%{POSTFIX_ANVIL_CONN_CACHE}|%{POSTFIX_ANVIL_CONN_COUNT}",
          "POSTFIX_ANVIL_RATE": """statistics: max (?<postfix_anvil_rate_type>message|recipient|newtls|auth) rate %{NUMBER:postfix_anvil_rate:int}/(?<postfix_anvil_conn_period>\d+[smhd]) for \(%{DATA:postfix_service}:(%{IP_UNKNOWN:postfix_client_ip_unknown}|%{IP:postfix_client_ip})\) at %{SYSLOGTIMESTAMP:postfix_anvil_timestamp}""",
          "POSTFIX_CLEANUP": "%{POSTFIX_CLEANUP_MESSAGEID}|%{POSTFIX_CLEANUP_MILTER}|%{POSTFIX_CLEANUP_PREPEND}|%{POSTFIX_WARNING}|%{POSTFIX_KEYVALUE}",
          "POSTFIX_QMGR": "%{POSTFIX_QMGR_INFO}|%{POSTFIX_QMGR_ACTIVE}|%{POSTFIX_QMGR_EXPIRED}|%{POSTFIX_QMGR_DELIVERY}|%{POSTFIX_WARNING}",
          "POSTFIX_QMGR_DELIVERY": """%{POSTFIX_KEYVALUE} status=%{STATUS_WORD:postfix_status}( \(%{GREEDYDATA:postfix_qmgr_response}\))?""",
          "POSTFIX_TLSVERIFICATION": "(server )?certificate verification failed for %{POSTFIX_RELAY}: %{GREEDYDATA:postfix_tls_error}",
          "POSTFIX_MASTER_EXIT": "terminating on signal %{INT:postfix_termination_signal:int}",
          "POSTFIX_WARNING": "%{POSTFIX_SMTPD_SASL_AUTH_FAILED}|%{POSTFIX_SMTPD_RATELIMIT}|%{POSTFIX_WARNING_WITH_KV}|%{POSTFIX_WARNING_WITHOUT_KV}",
          "POSTFIX_SMTPD_SASL_AUTH_FAILED": "(?<postfix_message_level>warning): %{POSTFIX_CLIENT}: SASL (?<postfix_sasl_method>[A-Za-z0-9-]+) authentication failed(: %{DATA:postfix_sasl_reason}(, sasl_username=%{GREEDYDATA:postfix_sasl_username})?)?",
          "POSTFIX_SMTPD_RATELIMIT": "(?<postfix_message_level>warning): (?<postfix_ratelimit_type>[A-Za-z ]+?) limit exceeded: %{INT:postfix_ratelimit_value:int} from %{POSTFIX_CLIENT} for service %{DATA:postfix_service}",
          "POSTFIX_SCACHE_TIMESTAMP": "statistics: start interval %{SYSLOGTIMESTAMP:postfix_scache_timestamp}",
          "POSTFIX_SCRIPT": "%{POSTFIX_SCRIPT_ACTION}|%{POSTFIX_WARNING}",
          "POSTFIX_SCRIPT_ACTION": "(?<postfix_script_action>(starting|stopping|refreshing)) the Postfix mail system",
          "POSTFIX_PS_CONNECT": """CONNECT from %{POSTFIX_CLIENT} to \[%{IP:postfix_server_ip}\]:%{INT:postfix_server_port:int}""",
          "POSTFIX_SMTP_UTF8": "host %{POSTFIX_RELAY} offers SMTPUTF8 support, but not 8BITMIME",
          "STATUS_WORD": """[\w-]*""",
          "POSTFIX_QUEUEID": "([0-9A-F]{6,}|[0-9a-zA-Z]{12,}|NOQUEUE)",
          "POSTFIX_RELAY": """%{POSTFIX_HOSTNAME:postfix_relay_hostname}?\[(%{IP:postfix_relay_ip}|%{DATA:postfix_relay_service})\](:%{INT:postfix_relay_port:int})?|(?<postfix_relay_service>[\w./-]+)""",
          "POSTFIX_WARNING_WITHOUT_KV": "(%{POSTFIX_QUEUEID:postfix_queueid}: )?(?<postfix_message_level>(error|warning|fatal|info)): (%{POSTFIX_QUEUEID:postfix_queueid}: )?(%{POSTFIX_CLIENT}: )?%{GREEDYDATA:postfix_message}",
          "POSTFIX_PROXY_MESSAGE": "(%{POSTFIX_STATUS_CODE:postfix_proxy_status_code} )?(%{POSTFIX_STATUS_CODE_ENHANCED:postfix_proxy_status_code_enhanced})?.*",
          "POSTFIX_STATUS_CODE_ENHANCED": """\d\.\d+\.\d+""",
          "POSTFIX_PS_TOOBUSY": "NOQUEUE: reject: CONNECT from %{POSTFIX_CLIENT}: %{GREEDYDATA:postfix_postscreen_toobusy_data}",
          "POSTFIX_TLSCONN": """%{DATA:postfix_tls_trustlevel} TLS connection established (to %{POSTFIX_RELAY}|from %{POSTFIX_CLIENT}): %{DATA:postfix_tls_version} with cipher %{DATA:postfix_tls_cipher} \(%{INT:postfix_tls_cipher_size:int}(/%{INT})? bits\)( key-exchange %{DATA:postfix_tls_key_exchange} server-signature %{DATA:postfix_tls_server_signature} \((%{INT:postfix_tls_server_signature_size:int} bits|(?<postfix_tls_server_signature_curve>[PBK]-\d+))\) server-digest %{DATA:postfix_tls_server_digest}( client-signature %{DATA:postfix_tls_client_signature} \((%{INT:postfix_tls_client_signature_size:int} bits|(?<postfix_tls_client_signature_curve>[PBK]-\d+))\) client-digest %{DATA:postfix_tls_client_digest})?)?""",
          "POSTFIX_SMTPD_PROXY": "proxy-%{POSTFIX_ACTION:postfix_proxy_result}: (%{POSTFIX_SMTP_STAGE:postfix_proxy_smtp_stage}): %{POSTFIX_PROXY_MESSAGE:postfix_proxy_message}; %{POSTFIX_KEYVALUE_DATA:postfix_keyvalue_data}",
          "POSTFIX_PICKUP": "%{POSTFIX_KEYVALUE}",
          "POSTFIX_VIRTUAL": "%{POSTFIX_SMTP_DELIVERY}",
          "GREEDYDATA_NO_BRACKET": "[^<>]*",
          "POSTFIX_PS_ACCESS_ACTION": "(DISCONNECT|DENYLISTED|BLACKLISTED|ALLOWLISTED|WHITELISTED|ALLOWLIST VETO|WHITELIST VETO|PASS NEW|PASS OLD)",
          "POSTFIX_TLSPROXY": "%{POSTFIX_TLSPROXY_CONN}|%{POSTFIX_TLSCONN}|%{POSTFIX_WARNING}",
          "POSTFIX_ACTION": "(accept|bcc|defer|discard|filter|header-redirect|hold|milter-reject|redirect|reject|reject_warning|warn)",
          "POSTFIX_SMTP_DELIVERY": """%{POSTFIX_KEYVALUE} status=%{STATUS_WORD:postfix_status}( \(%{GREEDYDATA:postfix_smtp_response}\))?""",
          "POSTFIX_SCACHE_SIMULTANEOUS": "statistics: max simultaneous domains=%{INT:postfix_scache_domains:int} addresses=%{INT:postfix_scache_addresses:int} connection=%{INT:postfix_scache_connection:int}",
          "POSTFIX_PS_VIOLATIONS": "%{POSTFIX_PS_VIOLATION:postfix_postscreen_violation}( %{INT})?( after %{NUMBER:postfix_postscreen_violation_time:float})? from %{POSTFIX_CLIENT}(( after %{POSTFIX_SMTP_STAGE:postfix_smtp_stage})?(: %{GREEDYDATA:postfix_postscreen_data})?| in tests (after|before) SMTP handshake)",
