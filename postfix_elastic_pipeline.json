      "script": {
        "tag": "ecs_event_outcome",
        "description": "event.action from the delivery status or access/header/milter action; event.type and event.outcome from that",
        "lang": "painless",
        "source": "Map e = ctx.event; String s = ctx.postfix_status; if (e.action == null) { if (s != null) { e.action = s; } else if (ctx.postfix_action != null) { e.action = ctx.postfix_action; } else if (ctx.postfix_cleanup_action != null) { e.action = ctx.postfix_cleanup_action; } else if (ctx.postfix_milter_result != null) { e.action = 'milter-' + ctx.postfix_milter_result; } } String a = e.action; if (a == 'connect' || a == 'disconnect') { e.type = ['connection', a == 'connect' ? 'start' : 'end']; if (!e.category.contains('network')) { e.category.add('network'); } } else if (a == 'reject' || a == 'milter-reject' || a == 'defer' || a == 'discard' || a == 'milter-discard') { e.type = ['denied']; } else if (a != null) { e.type = ['info']; } if (s == 'sent' || s == 'deliverable') { e.outcome = 'success'; } else if (s == 'bounced' || s == 'deferred' || s == 'expired' || s == 'undeliverable') { e.outcome = 'failure'; } else if (s == null && e.type != null && e.type.contains('denied')) { e.outcome = 'failure'; }"
      }
    },
    {
      "script": {
        "tag": "ecs_tls",
        "lang": "painless",
        "source": "def v = ctx.remove('postfix_tls_version'); if (v != null) { if (ctx.tls == null) { ctx.tls = new HashMap(); } ctx.tls.established = true; if (v.startsWith('TLSv')) { ctx.tls.version_protocol = 'tls'; ctx.tls.version = v.substring(4); } else if (v.startsWith('SSLv')) { ctx.tls.version_protocol = 'ssl'; ctx.tls.version = v.substring(4); } else { ctx.tls.version = v; } } def c = ctx.remove('postfix_tls_cipher'); if (c != null) { if (ctx.tls == null) { ctx.tls = new HashMap(); } ctx.tls.cipher = c; }"
      }
    },
