      "append": {
        "if": "ctx.source?.domain != null",
        "field": "related.hosts",
        "value": ["{{{source.domain}}}"],
        "allow_duplicates": false
      }
    },
    {
      "append": {
        "if": "ctx.destination?.domain != null",
        "field": "related.hosts",
        "value": ["{{{destination.domain}}}"],
        "allow_duplicates": false
      }
    },
    {
      "append": {
        "if": "ctx.postfix_sasl_username != null",
        "field": "related.user",
        "value": ["{{{postfix_sasl_username}}}"],
        "allow_duplicates": false
      }
    },
    {
      "script": {
        "tag": "namespace_custom_fields",
        "description": "Move prefix_* fields into prefix.* objects",
        "lang": "painless",
        "source": "Map ns = ['postfix_': 'postfix', 'opendkim_': 'opendkim', 'opendmarc_': 'opendmarc', 'policyd_spf_': 'policyd_spf']; for (String k : new ArrayList(ctx.keySet())) { for (String p : ns.keySet()) { if (k.startsWith(p)) { String t = ns.get(p); if (!(ctx[t] instanceof Map)) { ctx[t] = new HashMap(); } ctx[t][k.substring(p.length())] = ctx.remove(k); break; } } }"
      }
    }
  ],
  "on_failure": [
    {
      "set": {
        "field": "error.message",
        "value": "{{ _ingest.on_failure_processor_type }} [{{ _ingest.on_failure_processor_tag }}]: {{ _ingest.on_failure_message }}"
      }
    },
    {
      "set": {
        "field": "error.tag",
        "value": "parse_failure"
      }
    },
    {
      "append": {
        "field": "tags",
        "value": ["parse_failure"],
        "allow_duplicates": false
      }
    }
  ]
}
