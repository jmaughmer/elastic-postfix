{
  "_meta": {
    "description": "Explicit mappings for every field emitted by the logs-postfix@custom ingest pipeline, plus empty mappings for the Exchange integration fields that mail_flow_kibana_dashboard.ndjson queries, so its ES|QL panels work even when an Exchange integration isn't installed"
  },
